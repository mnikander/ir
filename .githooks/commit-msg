#!/bin/sh

msg_file="$1"
first_line="$(head -n 1 "$msg_file")"

pattern='^(impl|gen|fix|ref|test|proto|doc|tool)(\(.+\))?: .+'

if ! printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  echo "Error: commit message must start with one of: impl, gen, fix, ref, test, proto, doc, tool"
  echo
  echo "Examples:"
  echo "  impl: parser for low IR"
  echo "  fix: handle empty block correctly"
  echo "  ref(vm): simplify call frame layout"
  exit 1
fi
